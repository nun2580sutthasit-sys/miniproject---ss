{
  "info": {
    "name": "Save & Share API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": "PASTE_JWT_HERE"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"ผู้ทดสอบ\",\n  \"email\": \"student@example.com\",\n  \"password\": \"ChangeThis123!\",\n  \"universityId\": 1,\n  \"role\": \"seller\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{baseUrl}}/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"seller@example.com\",\"password\":\"DemoPass123\"}"
        },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "Search products",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/products?q=database&sort=low&universityId=1"
      }
    },
    {
      "name": "My orders (JWT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/orders"
      }
    },
    {
      "name": "Universities",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/universities"
      }
    },
    {
      "name": "Submit student verification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/verification",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentCode\": \"TEST12345\",\n  \"studentEmail\": \"student@example.com\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create product (verified seller)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"หนังสือ Database ทดสอบ\",\n  \"description\": \"รายการสำหรับทดสอบ API\",\n  \"category\": \"หนังสือ\",\n  \"price\": 120,\n  \"condition\": \"ใช้งานดี\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Create delivery order (verified buyer)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}",
            "type": "text"
          }
        ],
        "url": "{{baseUrl}}/orders",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 1\n    }\n  ],\n  \"fulfillment\": \"delivery\",\n  \"deliveryAddress\": \"ที่อยู่ทดสอบ\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Admin dashboard",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/stats"
      }
    },
    {
      "name": "Pending verifications",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/admin/verifications"
      }
    }
  ]
}
